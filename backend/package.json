{
  "name": "@chifa-yemheng/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:ping": "tsx src/scripts/db-ping.ts",
    "db:seed": "tsx src/scripts/db-seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:ui": "vitest run --reporter=ui",
    "logs:dev": "cross-env NODE_ENV=development LOG_PRETTY=true LOG_LEVEL=debug npx tsx watch src/server.ts",
    "logs:prod": "cross-env NODE_ENV=production LOG_PRETTY=false LOG_LEVEL=warn node dist/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "object-assign": "^4.1.1",
    "pino": "^8.15.0",
    "pino-http": "^9.0.0",
    "pino-pretty": "^10.0.0",
    "@sentry/node": "^7.70.0",
    "@sentry/integrations": "^7.70.0",
    "ws": "^8.22.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.23.1",
    "@types/pino": "^7.0.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.12",
    "cross-env": "^7.0.3",
    "supertest": "^7.3.1",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2",
    "vitest": "^4.1.12"
  }
}
